amends "modulepath:/api/ApiConfig.pkl"

org = "bryzek"

local tsSrc = "./src/generated"
local platformFilter = new Filter {
  types { "user_reference"; "person"; "token"; "token_form"; "created_token"; "user_activation"; "user_activation_password_form" }
  resources { "email_verification"; "tenant_session"; "user"; "phone"; "token"; "user_activation" }
}
local fileFilter = new Filter { types { "file" } }

// The call context (DES-65431): every generated operation takes `{ route, view, part, recorder }`
// first, so each call names its screen view and part and the type checker finds every call site.
local callContextAttrs = new Mapping<String, Any> {
  ["call_context"] = true
}

applications = new Listing<AppGroup> {
  new { names { "platform" };         generators = module.singleGenerator("typescript", tsSrc); filter = platformFilter; attributes = callContextAttrs }
  new { names { "platform-storage" }; generators = module.singleGenerator("typescript", tsSrc); filter = fileFilter; attributes = callContextAttrs }
  new { names { "apibuilder-spec"; "apibuilder"; "apibuilder-generator"; "platform-error" }
                                      generators = module.singleGenerator("typescript", tsSrc); attributes = callContextAttrs }
}

// playwright/ is its own codegen root: it regenerates a narrower client into
// playwright/generated, which must not land in src/ and reach the shipped
// bundle. Naming it here is what makes a single `api` at the repo root cover
// both — without it the copy only updated if you remembered to cd into
// playwright/ and run `api` again, and it silently rotted (hackathon hit exactly
// this, #54). `dev codegen sync` resolves a repo's codegen roots from this list
// too, so an undeclared root is one the nightly sweep leaves alone (ISS-1489).
nestedConfigs {
  "playwright"
}

// The base API specs (platform-error, platform-storage) are read from play-core, where they are declared. ISS-59587
specSources {
  "play-core"
}
