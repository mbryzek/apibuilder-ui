{
  "name": "apibuilder-ui-temp",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "^24.16.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run check:e2e && npm run lint && npm run test:unit",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "node scripts/ci-test.mjs vitest",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "lint": "svelte-kit sync && eslint src playwright --max-warnings 0",
    "lint:fix": "svelte-kit sync && eslint src playwright --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:e2e": "tsc -p tsconfig.playwright.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-cloudflare": "^8.0.1",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "semver": "^7.8.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "svelte-eslint-parser": "^1.10.0",
    "svelte-vitals": "0.55.3",
    "typescript": "~6.0.3",
    "ui": "github:mbryzek/ui",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "@sveltejs/adapter-cloudflare": "^8.0.1",
    "@tailwindcss/forms": "^0.5.11",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
    "sharp@0.35.4": "0.35.5",
    "undici@7.29.1": "7.30.1"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#generated/*": "./src/generated/*"
  }
}
