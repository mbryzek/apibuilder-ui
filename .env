# The localhost defaults for the API and the app's own origin are in
# src/lib/config-values.ts and not here: a production build reads this file too, so a value here
# would stand in for a key .env.production lost. ISS-37645
VITE_TENANT_ID=apibuilder
VITE_ENVIRONMENT=development

# PostHog write key (phc_..., public by design).
VITE_POSTHOG_API_KEY=phc_vVeZCSxky9r35pWrusNRySrTErvtJSWrL3FSFhA3YNdQ

# This project's id in the personal PostHog organization, not a secret: which project the
# release's sourcemap upload targets (dev release sveltekit, devops credentials/runbooks/posthog.md).
POSTHOG_CLI_PROJECT_ID=723544

# Version stamp: release-sveltekit exports the real PUBLIC_VERSION /
# PUBLIC_RELEASED_AT into the build environment (process env beats .env files);
# these empty defaults just keep non-release builds compiling.
PUBLIC_VERSION=""
PUBLIC_RELEASED_AT=""
